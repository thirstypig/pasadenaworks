# build output
dist/

# generated types
.astro/

# Tina admin — auto-generated GraphQL client/schema, regenerated by
# `npm run admin`. tina/config.ts (the actual schema you edit) is not
# ignored.
tina/__generated__/

# dependencies
node_modules/

# logs
npm-debug.log*

# environment variables
.env
.env.production

# macOS
.DS_Store

# editors
.vscode/*
!.vscode/extensions.json
.idea/
.playwright-mcp/

# Playwright MCP writes screenshots to the CWD, which is the repo root when a
# browser check runs during a session. One (queue.png, 131KB) reached main on
# 2026-09-10 via `git add -A`. Ignore the shapes it produces so a broad add
# cannot sweep a screenshot into a content commit again.
*.png.tmp
/queue.png
/page-*.png
/screenshot*.png

# Cross-project port registry: kept on disk, never published (names private projects).
# Synced from ~/Projects/MASTER-PORTS.md by ~/Projects/sync-master-ports.sh.
MASTER-PORTS.md
