---
import Base from './Base.astro';
import { absoluteUrl } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  path: string;
}

const { title, description, pubDate, updatedDate, path } = Astro.props;
const ogImage = absoluteUrl('/og.png');
---

<Base title={title} description={description} locale="en" path={path} ogType="article">
  <meta slot="head" property="article:published_time" content={pubDate.toISOString()} />
  {updatedDate && (
    <meta slot="head" property="article:modified_time" content={updatedDate.toISOString()} />
  )}
  <article class="section wrap prose post">
    <p class="post__meta">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {updatedDate && (
        <>
          {' · Updated '}
          <time datetime={updatedDate.toISOString()}>
            {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </>
      )}
    </p>
    <h1>{title}</h1>
    <div class="post__body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .post__meta {
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--color-ink-soft);
  }

  .post__body :global(h2) {
    margin-top: var(--space-7);
  }

  .post__body :global(a) {
    color: var(--color-accent-dark);
  }
</style>
