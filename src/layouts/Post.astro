---
import { jsonLd } from '../utils/json-ld';
import Base from './Base.astro';
import TagPill from '../components/TagPill.astro';
import EndCta from '../components/EndCta.astro';
import { absoluteUrl } from '../i18n/routes';
import { blogIndexPath, formatPostDate, readingLabel, updatedLabel, byLabel } from '../utils/blog';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  path: string;
  locale: Locale;
  translations?: Partial<Record<Locale, string>>;
  author: string;
  tags: string[];
  pillar: 'websites' | 'search' | 'consulting' | 'ads';
  readingMinutes: number;
  heroImage?: string;
  heroAlt?: string;
  heroCredit?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  path,
  locale,
  translations,
  author,
  tags,
  pillar,
  readingMinutes,
  heroImage,
  heroAlt,
  heroCredit,
} = Astro.props;

const strings = t(locale);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Organization', name: author },
  ...(heroImage && { image: heroImage }),
  mainEntityOfPage: absoluteUrl(path),
};
---

<Base
  title={title}
  description={description}
  locale={locale}
  path={path}
  translations={translations}
  ogType="article"
>
  <meta slot="head" property="article:published_time" content={pubDate.toISOString()} />
  {updatedDate && (
    <meta slot="head" property="article:modified_time" content={updatedDate.toISOString()} />
  )}
  <script slot="head" type="application/ld+json" set:html={jsonLd(articleSchema)} />
  <article class="section wrap post">
    <a class="post__back" href={blogIndexPath(locale)}>&larr; {strings.buttons.backToBlog}</a>

    <p class="post__meta">
      <time datetime={pubDate.toISOString()}>
        {formatPostDate(pubDate, locale)}
      </time>
      {updatedDate && (
        <>
          {` · ${updatedLabel(locale)} `}
          <time datetime={updatedDate.toISOString()}>
            {formatPostDate(updatedDate, locale)}
          </time>
        </>
      )}
      {' · '}{readingLabel(readingMinutes, locale)}
      <span class="post__pills">
        {tags.map((tag) => <TagPill tag={tag} />)}
      </span>
    </p>

    <div class="prose">
      <h1>{title}</h1>
      <p class="post__subtitle">{description}</p>
      <p class="post__author">{byLabel(locale)} {author}</p>
    </div>

    {heroImage && (
      <figure class="post__hero">
        <div class="post__hero-frame label-frame">
          <img src={heroImage} alt={heroAlt ?? ''} loading="eager" />
        </div>
        {heroCredit && <figcaption>Photo: {heroCredit}</figcaption>}
      </figure>
    )}

    <div class="post__body prose">
      <slot />
      <EndCta pillar={pillar} locale={locale} />
    </div>
  </article>
</Base>

<style>
  .post__back {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--color-ink-soft);
    text-decoration: none;
    margin-bottom: var(--space-5);
  }

  .post__back:hover {
    color: var(--color-accent-text);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--color-ink-soft);
    margin-bottom: var(--space-3);
  }

  .post__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-left: var(--space-2);
  }

  .post__subtitle {
    font-size: var(--step-1);
    color: var(--color-ink-soft);
    margin-top: calc(var(--space-4) * -1 + var(--space-2));
  }

  .post__author {
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--color-ink-soft);
  }

  .post__hero {
    max-width: var(--max-width-prose);
    margin: var(--space-6) 0;
  }

  .post__hero-frame {
    color: var(--color-rose-dark);
    padding: var(--space-2);
    background: var(--color-surface);
  }

  .post__hero img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
  }

  .post__hero figcaption {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--color-ink-soft);
  }

  .post__hero figcaption a {
    color: inherit;
  }

  .post__body {
    margin-top: var(--space-6);
  }

  .post__body :global(p) {
    margin-bottom: var(--space-5);
  }

  .post__body :global(strong),
  .post__body :global(b) {
    color: var(--color-heading);
    font-weight: 600;
  }

  .post__body :global(em),
  .post__body :global(i) {
    color: var(--color-ink-soft);
    font-style: italic;
  }

  /* Links in article prose are underlined AT REST, not only on hover.
     They used to be distinguished by colour alone, and the accent against
     surrounding body text measures 2.96:1 in light mode and 2.53:1 in dark
     — under WCAG 1.4.1's 3:1 floor, so a reader who does not separate those
     hues could not find the links at all. Hover is not a fix: it does not
     exist on touch, and you cannot hover a link you never spotted.

     currentColor first so a browser without color-mix() still gets a solid
     underline; the mix then softens it to about 45% so a paragraph with
     several links does not turn into a fence. */
  /* `:not(.btn)` for the same reason `.section--dark a:not(.btn)` exists in
     global.css: the End CTA renders a `.btn` INSIDE `.post__body`, and this
     selector's specificity (0,2,1) beats `.btn` (0,1,0). Without the guard it
     paints an underline along the button's bottom edge and overrides its text
     colour — on every post, in all four languages. The bug was invisible while
     this border was transparent; making it visible is what surfaced it. */
  .post__body :global(a:not(.btn)) {
    color: var(--color-accent-text);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    border-bottom-color: color-mix(in srgb, currentColor 45%, transparent);
  }

  .post__body :global(a:not(.btn):hover),
  .post__body :global(a:not(.btn):focus-visible) {
    border-bottom-color: currentColor;
  }

  .post__body :global(h2) {
    margin-top: var(--space-8);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }

  .post__body :global(h3) {
    margin-top: var(--space-7);
  }

  .post__body :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-5) var(--space-6);
    border-left: 3px solid var(--color-ochre);
    background: rgba(200, 134, 43, 0.06);
    font-style: normal;
    color: var(--color-ink);
  }

  .post__body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .post__body :global(blockquote strong:first-child) {
    color: var(--color-accent-text);
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    margin-bottom: var(--space-5);
  }

  .post__body :global(li) {
    margin-bottom: var(--space-2);
  }
</style>
