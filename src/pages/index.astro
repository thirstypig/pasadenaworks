---
/**
 * English homepage. Holds its own copy directly — this is the one page
 * where prose lives in the template rather than in src/data/.
 */
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Lattice from '../components/Lattice.astro';
import { services } from '../data/services';
import { SEGMENTS, localeUrl } from '../i18n/routes';

const translations = {
  en: '/',
  es: '/es/',
  'zh-hans': '/zh-hans/',
  'zh-hant': '/zh-hant/',
};
---

<Base
  title="Pasadena Works — Websites &amp; Local SEO for Small Businesses"
  description="Websites, local SEO, and paid ads for small businesses in Pasadena and the San Gabriel Valley. Plain-spoken, no jargon, no long contracts."
  locale="en"
  path="/"
  translations={translations}
  isHome
>
  <section class="section--dark hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">Pasadena &amp; the San Gabriel Valley</p>
        <h1>Digital work for small businesses that gets more customers finding you.</h1>
        <p class="hero__subhead prose">
          Websites, Google visibility, and paid ads for small businesses in
          Pasadena and the San Gabriel Valley — sold to you honestly, and
          never held hostage.
        </p>
        <a class="btn" href="#contact">Get in touch</a>
      </div>
      <div class="hero__logo-frame label-frame">
        <img src="/logo-lockup.png" width="1600" height="578" alt="Pasadena Works" />
      </div>
    </div>
  </section>

  <Lattice variant="dark" />

  <section class="section">
    <div class="wrap">
      <h2>What we do</h2>
      <p class="prose">Four services, none of them complicated. Start with whichever one is actually costing you customers right now.</p>
      <div class="service-grid">
        {services.map((service) => (
          <a
            class="service-card label-frame"
            href={localeUrl('en', SEGMENTS.services.en, service.slugs.en)}
          >
            <h3>{service.t.en.title}</h3>
            <p>{service.t.en.summary}</p>
            <span class="service-card__link">View service &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Lattice />

  <section class="section" id="contact">
    <div class="wrap">
      <h2>Get in touch</h2>
      <p class="prose">Tell us what's going on with your website or your Google presence. We'll respond with something specific, not a form-letter proposal.</p>
      <div class="contact-frame label-frame">
        <ContactForm locale="en" />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-9);
  }

  .hero__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap-reverse;
  }

  .hero__text {
    flex: 1 1 28rem;
    min-width: 0;
  }

  .hero__logo-frame {
    flex: 0 0 auto;
    width: min(420px, 80vw);
    padding: var(--space-5) var(--space-4);
    color: var(--color-rose-dark);
    background: var(--color-bg);
    filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.35));
  }

  .hero__logo-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__eyebrow {
    font-family: var(--font-display);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-blush);
  }

  .hero h1 {
    max-width: 16em;
  }

  .hero__subhead {
    font-size: var(--step-1);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .service-card {
    display: block;
    background: var(--color-white);
    padding: var(--space-6) var(--space-5) var(--space-5);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .service-card:hover {
    color: var(--color-accent-dark);
    transform: translateY(-2px);
  }

  .service-card__link {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--color-accent-dark);
  }

  .contact-frame {
    margin-top: var(--space-6);
    padding: var(--space-6);
    background: var(--color-white);
    color: var(--color-ink);
    max-width: fit-content;
  }

</style>
