---
/**
 * English homepage. Holds its own copy directly — this is the one page
 * where prose lives in the template rather than in src/data/.
 */
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Lattice from '../components/Lattice.astro';
import { services } from '../data/services';
import { SEGMENTS, localeUrl } from '../i18n/routes';
import { site } from '../data/site';
import { homeTranslations } from '../data/home';

const translations = homeTranslations();
---

<Base
  title="Pasadena Works — Websites & Local SEO for Small Businesses"
  description="Websites, local SEO, and paid ads for small businesses in Pasadena and the San Gabriel Valley. Plain-spoken, no jargon, no long contracts."
  locale="en"
  path="/"
  translations={translations}
  isHome
>
  <section class="section--dark hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">Pasadena &amp; the San Gabriel Valley</p>
        <h1>Digital work for small businesses that gets more customers finding you.</h1>
        <p class="hero__subhead prose">
          Websites, Google visibility, and paid advertising for small
          businesses throughout Pasadena and the San Gabriel Valley — sold to
          you honestly, explained without jargon, and never subsequently held
          hostage against your own domain.
        </p>
        <a class="btn" href="#contact">Get in touch</a>
      </div>
      <div class="hero__logo-frame label-frame">
        <img src="/logo-lockup.png" width="1600" height="578" alt="Pasadena Works" />
      </div>
    </div>
  </section>

  <Lattice variant="dark" />

  <section class="section">
    <div class="wrap">
      <h2>What we do</h2>
      <p class="prose">There are four services and none of them is especially complicated, so begin with whichever one is genuinely costing you customers at the moment, rather than with whichever happens to sound most impressive.</p>
      <div class="service-grid">
        {services.map((service) => (
          <a
            class="service-card label-frame"
            href={localeUrl('en', SEGMENTS.services.en, service.slugs.en)}
          >
            <h3>{service.t.en.title}</h3>
            <p>{service.t.en.summary}</p>
            <span class="service-card__link">View service &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Lattice />

  <section class="section" id="contact">
    <div class="wrap">
      <h2>Get in touch</h2>
      <p class="prose">Tell us what is currently happening with your website or your Google presence, in whatever detail you happen to have available. We will respond with something specific to your particular situation, rather than with a form-letter proposal assembled beforehand.</p>
      <p class="prose">
        Would you rather talk sooner than an email exchange allows? <a href={site.bookingUrl} target="_blank" rel="noopener" class="btn">Schedule a call now &rarr;</a>
      </p>
      <div class="contact-frame label-frame">
        <ContactForm locale="en" />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-9);
  }

  .hero__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap-reverse;
  }

  .hero__text {
    flex: 1 1 28rem;
    min-width: 0;
  }

  .hero__logo-frame {
    flex: 0 0 auto;
    width: min(560px, 85vw);
    padding: var(--space-6) var(--space-5);
    color: var(--color-rose-dark);
    background: var(--color-bg);
    border-width: 5px;
    outline-width: 2px;
    outline-offset: 8px;
    filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.35));
  }

  .hero__logo-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__eyebrow {
    font-family: var(--font-display);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-blush);
  }

  .hero h1 {
    max-width: 16em;
  }

  .hero__subhead {
    font-size: var(--step-1);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .service-card {
    display: block;
    background: var(--color-surface);
    padding: var(--space-6) var(--space-5) var(--space-5);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .service-card:hover {
    color: var(--color-accent-text);
    transform: translateY(-2px);
  }

  .service-card__link {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--color-accent-text);
  }

</style>
