---
import Base from '../../layouts/Base.astro';
import { services } from '../../data/services';
import { SEGMENTS, localeUrl, servicesIndexPaths } from '../../i18n/routes';
import { t } from '../../i18n/utils';

const strings = t('en');

const translations = servicesIndexPaths();
---

<Base
  title="Services — Pasadena Works"
  description={strings.hub.servicesDescription}
  locale="en"
  path="/services/"
  translations={translations}
>
  <section class="section wrap">
    <h1>Services</h1>
    <p class="prose">{strings.hub.servicesIntro}</p>
    <div class="service-grid">
      {services.map((service) => (
        <a class="service-card" href={localeUrl('en', SEGMENTS.services.en, service.slugs.en)}>
          <h2>{service.t.en.title}</h2>
          <p>{service.t.en.summary}</p>
          <span class="service-card__link">View service &rsaquo;</span>
        </a>
      ))}
    </div>
  </section>
</Base>

{/* .service-card, .service-card:hover, .service-card__link now live in
    global.css — this page's copy was byte-identical to two others
    (todos/024). */}
