---
import Base from '../../layouts/Base.astro';
import { services } from '../../data/services';
import { SEGMENTS, localeUrl, servicesIndexPaths } from '../../i18n/routes';
import { t } from '../../i18n/utils';

const strings = t('en');

const translations = servicesIndexPaths();
---

<Base
  title="Services — Pasadena Works"
  description={strings.hub.servicesDescription}
  locale="en"
  path="/services/"
  translations={translations}
>
  <section class="section wrap">
    <h1>Services</h1>
    <p class="prose">{strings.hub.servicesIntro}</p>
    <div class="service-grid">
      {services.map((service) => (
        <a class="service-card" href={localeUrl('en', SEGMENTS.services.en, service.slugs.en)}>
          <h2>{service.t.en.title}</h2>
          <p>{service.t.en.summary}</p>
          <span class="service-card__link">View service &rarr;</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>

  .service-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: var(--space-5);
    text-decoration: none;
    color: var(--color-ink);
  }

  .service-card:hover {
    border-color: var(--color-accent);
  }

  .service-card__link {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--color-accent-text);
  }
</style>
