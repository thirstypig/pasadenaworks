---
import Base from '../../layouts/Base.astro';
import { services } from '../../data/services';
import { SEGMENTS, localeUrl } from '../../i18n/routes';

const translations = {
  en: '/services/',
  es: `/es/${SEGMENTS.services.es}/`,
  'zh-hans': `/zh-hans/${SEGMENTS.services['zh-hans']}/`,
  'zh-hant': `/zh-hant/${SEGMENTS.services['zh-hant']}/`,
};
---

<Base
  title="Services — Pasadena Works"
  description="Websites, local SEO, business consulting, and paid ads for small businesses in Pasadena and the San Gabriel Valley."
  locale="en"
  path="/services/"
  translations={translations}
>
  <section class="section wrap">
    <h1>Services</h1>
    <p class="prose">Four services, ordered by what matters most first.</p>
    <div class="service-grid">
      {services.map((service) => (
        <a class="service-card" href={localeUrl('en', SEGMENTS.services.en, service.slugs.en)}>
          <h2>{service.t.en.title}</h2>
          <p>{service.t.en.summary}</p>
          <span class="service-card__link">View service &rarr;</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .service-card {
    display: block;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: var(--space-5);
    text-decoration: none;
    color: var(--color-ink);
  }

  .service-card:hover {
    border-color: var(--color-accent);
  }

  .service-card__link {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-accent-dark);
  }
</style>
