---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { readingTime } from '../../utils/reading-time';
import { getPostsByLocale, getTranslationsFor, postPath } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPostsByLocale('en');
  return Promise.all(
    posts.map(async (post) => ({
      params: { slug: post.data.slug },
      props: { post, translations: await getTranslationsFor(post) },
    }))
  );
}

const { post, translations } = Astro.props;
const { Content } = await render(post);
const readingMinutes = readingTime(post.body);
---

<Post
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  path={postPath('en', post.data.slug)}
  locale="en"
  translations={translations}
  author={post.data.author}
  tags={post.data.tags}
  pillar={post.data.pillar}
  readingMinutes={readingMinutes}
  heroImage={post.data.heroImage}
  heroAlt={post.data.heroAlt}
  heroCredit={post.data.heroCredit}
>
  <Content />
</Post>
