---
import Base from '../../layouts/Base.astro';
import BlogPostGrid from '../../components/BlogPostGrid.astro';
import { readingTime } from '../../utils/reading-time';
import { getPostsByLocale, blogIndexPath } from '../../utils/blog';

const allPosts = await getPostsByLocale('en');
const posts = allPosts.map((post) => ({ post, minutes: readingTime(post.body) }));

const translations = {
  en: blogIndexPath('en'),
  es: blogIndexPath('es'),
  'zh-hans': blogIndexPath('zh-hans'),
  'zh-hant': blogIndexPath('zh-hant'),
};
---

<Base
  title="Blog — Pasadena Works"
  description="Plain-spoken articles on websites, local search, business decisions, and paid ads for small business owners in the San Gabriel Valley."
  locale="en"
  path="/blog/"
  translations={translations}
>
  <section class="section wrap">
    <h1>Blog</h1>
    <p class="prose">
      Answers to the questions small business owners actually ask us,
      written the same way we'd say them out loud.
    </p>
    <BlogPostGrid locale="en" posts={posts} />
  </section>
</Base>
