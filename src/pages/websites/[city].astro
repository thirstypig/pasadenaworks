---
import Base from '../../layouts/Base.astro';
import CityBody from '../../components/CityBody.astro';
import EndCta from '../../components/EndCta.astro';
import { cities, cityLocales } from '../../data/cities';
import { SEGMENTS, localeUrl } from '../../i18n/routes';
import { LOCALES, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return cities
    .filter((city) => cityLocales(city).includes('en'))
    .map((city) => ({
      params: { city: city.slug },
      props: { city },
    }));
}

const { city } = Astro.props;
const copy = city.t.en!;
const locales = cityLocales(city);

const translations = Object.fromEntries(
  (LOCALES.filter((l: Locale) => locales.includes(l)) as Locale[]).map((locale) => [
    locale,
    localeUrl(locale, SEGMENTS.cityHub[locale], city.slug),
  ])
);
---

<Base
  title={`${copy.title} — Pasadena Works`}
  description={copy.meta}
  locale="en"
  path={localeUrl('en', SEGMENTS.cityHub.en, city.slug)}
  translations={translations}
>
  <section class="section wrap">
    <h1>{copy.title}</h1>
    <p class="prose">{copy.summary}</p>
    <CityBody copy={copy} locale="en" slug={city.slug} />
    {/* Who you would be working with, and that the practice alone pays us.
        Identical on every city page ON PURPOSE — furniture, like the footer,
        so it sits outside cities.test.ts's duplicate-sentence check rather
        than defeating it. The city-specific argument lives in the third
        paragraph above, where that check can see it. */}
    <EndCta serviceId="consulting" locale="en" />
    <p class="page-back"><a href="/websites/">&lsaquo; All cities</a></p>
  </section>
</Base>
