---
import Base from '../../layouts/Base.astro';
import { cities, cityLocales, cityDisplayName } from '../../data/cities';
import { SEGMENTS, localeUrl, cityHubPaths } from '../../i18n/routes';

const translations = cityHubPaths();

const englishCities = cities.filter((c) => cityLocales(c).includes('en'));

const description = `Consulting for independent medical, dental, and eye care practices in ${englishCities
  .map((c) => cityDisplayName(c.slug))
  .join(', ')}.`;
---

<Base
  title="Cities we work in — Pasadena Works"
  description={description}
  locale="en"
  path="/websites/"
  translations={translations}
>
  <section class="section wrap">
    <h1>Cities we work in</h1>
    <p class="prose">
      We work with independent practices across the San Gabriel Valley, and
      each city page starts from that city&rsquo;s own clinician registry and
      Census figures rather than from a template.
    </p>
    <ul class="city-list">
      {englishCities.map((city) => (
        <li>
          <a href={localeUrl('en', SEGMENTS.cityHub.en, city.slug)}>
            {city.t.en!.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .city-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
</style>
