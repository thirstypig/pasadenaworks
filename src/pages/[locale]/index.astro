---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import Lattice from '../../components/Lattice.astro';
import { services } from '../../data/services';
import { site } from '../../data/site';
import { home, homeTranslations } from '../../data/home';
import { SEGMENTS, localeUrl } from '../../i18n/routes';
import type { Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(home) as Locale[]).map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = home[locale]!;

const translations = homeTranslations();
---

<Base
  title={copy.title}
  description={copy.metaDescription}
  locale={locale}
  path={localeUrl(locale)}
  translations={translations}
  isHome
>
  <section class="section--dark hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">{copy.heroEyebrow}</p>
        <h1>{copy.heroHeading}</h1>
        <p class="hero__subhead prose">{copy.heroSubhead}</p>
        <a class="btn" href="#contact">{copy.heroCta}</a>
      </div>
      {/* Same lockup the English homepage carries, so all four languages match
          above the fold. The alt text is the brand name and stays in Latin in
          every locale: it IS the name, not a phrase to be translated. */}
      <div class="hero__logo-frame label-frame">
        <img src="/logo-lockup.png" width="1600" height="578" alt={site.name} />
      </div>
    </div>
  </section>

  <Lattice variant="dark" />

  <section class="section">
    <div class="wrap">
      <h2>{copy.servicesHeading}</h2>
      <p class="prose">{copy.servicesIntro}</p>
      <div class="service-grid">
        {services.map((service) => (
          <a
            class="service-card label-frame"
            href={localeUrl(locale, SEGMENTS.services[locale], service.slugs[locale])}
          >
            <h3>{service.t[locale].title}</h3>
            <p>{service.t[locale].summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Lattice />

  <section class="section--dark">
    <div class="wrap">
      <h2>{copy.serviceAreaHeading}</h2>
      <p class="prose">{copy.serviceAreaIntro}</p>
      <ul class="service-area">
        {site.serviceArea.map((city) => <li>{city}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap">
      <h2>{copy.closingHeading}</h2>
      <p class="prose">{copy.closingBody}</p>
      <div class="contact-frame label-frame">
        <ContactForm locale={locale} />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-9);
  }
  /* Mirrors src/pages/index.astro. The two homepages are separate files — the
     English one holds its copy inline, the localized one reads home.ts — so
     these rules exist twice on purpose. `homepages.test.ts` fails if they
     diverge again; they had, and nobody chose it. */
  .hero__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap-reverse;
  }
  .hero__text {
    flex: 1 1 28rem;
    min-width: 0;
  }
  .hero__logo-frame {
    flex: 0 0 auto;
    width: min(560px, 85vw);
    padding: var(--space-6) var(--space-5);
    color: var(--color-rose-dark);
    background: var(--color-bg);
    border-width: 5px;
    outline-width: 2px;
    outline-offset: 8px;
    filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.35));
  }
  .hero__logo-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__eyebrow {
    font-family: var(--font-display);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-blush);
  }

  .hero h1 {
    max-width: 16em;
  }

  .hero__subhead {
    font-size: var(--step-1);
  }

  /* .service-card, .service-card:hover now live in global.css — this page's
     copy was byte-identical to two others (todos/024). */

  .service-area {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    font-family: var(--font-display);
  }
</style>
