---
/**
 * Triple-purpose hub index: renders the translated services index, the
 * translated city-hub index, OR the translated blog index, branching on
 * `kind`. All three live at [locale]/[section]/ depth, so they share one
 * file rather than colliding dynamic routes — same pattern as
 * [service].astro one level down.
 */
import Base from '../../../layouts/Base.astro';
import { services } from '../../../data/services';
import { cities, cityLocales } from '../../../data/cities';
import { SEGMENTS, localeUrl, servicesIndexPaths, cityHubPaths, blogIndexPaths } from '../../../i18n/routes';
import { t } from '../../../i18n/utils';
import { LOCALES, type Locale } from '../../../i18n/ui';
import { getPostsByLocale, blogIndexPath } from '../../../utils/blog';
import { readingTime } from '../../../utils/reading-time';
import BlogPostGrid from '../../../components/BlogPostGrid.astro';
import type { CollectionEntry } from 'astro:content';

/** The three hub kinds this route serves. Discriminated so a `kind` LITERAL
 *  TYPO is a compile error where it's written — `tsc` flags a comparison
 *  against a literal outside the union. A genuinely NEW, unhandled `kind` is
 *  caught by the runtime throw at the bottom of this file instead (which
 *  fails the build, not `tsc`) — there's no exhaustiveness check here, so
 *  don't over-trust `typecheck` alone to catch that case. Found overstated in
 *  the 2026-09-09 full-repo review, todos/028.
 *
 *  `posts` is required on the blog member and absent on the others, which
 *  retires the old `posts?:` + `posts ?? []` pairing — that combination let the
 *  blog index render with zero cards and no error if the prop were ever renamed,
 *  on a site whose SEO strategy IS the blog.
 *
 *  WARNING: this file's vocabulary differs from its sibling
 *  [locale]/[section]/[service].astro — here 'blog' is the INDEX and the city
 *  hub is 'city-hub'; there 'blog-post' is a post and the city detail page is
 *  'city'. Copying a `kind` literal between the two files is how this broke
 *  before. */
type HubProps =
  | { kind: 'service'; locale: Locale }
  | { kind: 'city-hub'; locale: Locale }
  | {
      kind: 'blog';
      locale: Locale;
      posts: { post: CollectionEntry<'blog'>; minutes: number }[];
    };

export async function getStaticPaths() {
  const NON_EN = LOCALES.filter((l) => l !== 'en') as Exclude<Locale, 'en'>[];
  const paths: { params: { locale: string; section: string }; props: HubProps }[] = [];

  for (const locale of NON_EN) {
    paths.push({
      params: { locale, section: SEGMENTS.services[locale] },
      props: { kind: 'service', locale },
    });
    paths.push({
      params: { locale, section: SEGMENTS.cityHub[locale] },
      props: { kind: 'city-hub', locale },
    });

    const posts = await getPostsByLocale(locale);
    paths.push({
      params: { locale, section: SEGMENTS.blog[locale] },
      props: {
        kind: 'blog',
        locale,
        posts: posts.map((post) => ({ post, minutes: readingTime(post.body) })),
      },
    });
  }

  return paths;
}

const props = Astro.props as HubProps;
const { kind, locale } = props;
const posts = props.kind === 'blog' ? props.posts : undefined;

/* A fourth `kind` must fail LOUDLY. Without this it falls through to the last
 * branch: title/description/path keep their '' initializers, absoluteUrl('')
 * resolves to the site root, and the page ships an empty <title> declaring the
 * HOMEPAGE as its canonical — with the build, the tests and the typecheck all
 * green. Proven during the 2026-09-03 review by renaming one `kind` literal to
 * the sibling route's word for the same concept, which shipped exactly that on
 * all 12 translated posts. CLAUDE.md's mitigation was "grep every if/else
 * first", i.e. a machine-checkable invariant guarded by hand; it had already
 * failed once (docs/solutions/logic-errors/
 * dual-purpose-route-bare-else-broke-on-third-kind.md). */
if (kind !== 'blog' && kind !== 'service' && kind !== 'city-hub') {
  throw new Error(
    `[locale]/[section]/index.astro: unhandled kind ${JSON.stringify(kind)}. ` +
      `Note this file's vocabulary differs from its sibling: 'blog' is the INDEX ` +
      `and 'city-hub' is what [service].astro calls 'city'.`
  );
}
const strings = t(locale);

const blogTranslations = blogIndexPaths();

const servicesTranslations = servicesIndexPaths();

const cityHubTranslations = cityHubPaths();

const localizedCities = cities.filter((c) => cityLocales(c).includes(locale));
---

{kind === 'blog' ? (
  <Base
    title={`${strings.nav.blog} — Pasadena Works`}
    description={strings.hub.blogDescription}
    locale={locale}
    path={blogIndexPath(locale)}
    translations={blogTranslations}
  >
    <section class="section wrap">
      <h1>{strings.nav.blog}</h1>
      <BlogPostGrid locale={locale} posts={posts ?? []} />
    </section>
  </Base>
) : kind === 'service' ? (
  <Base
    title={`${strings.nav.services} — Pasadena Works`}
    description={strings.hub.servicesDescription}
    locale={locale}
    path={localeUrl(locale, SEGMENTS.services[locale])}
    translations={servicesTranslations}
  >
    <section class="section wrap">
      <h1>{strings.nav.services}</h1>
      <p class="prose">{strings.hub.servicesIntro}</p>
      <div class="service-grid">
        {services.map((service) => (
          <a
            class="service-card"
            href={localeUrl(locale, SEGMENTS.services[locale], service.slugs[locale])}
          >
            <h2>{service.t[locale].title}</h2>
            <p>{service.t[locale].summary}</p>
            {/* The English index at src/pages/services/index.astro has carried
                this affordance since launch and the localized twin never did —
                two copies of one page, diverged in silence. `buttons.viewService`
                is now free: the localized service DETAIL page was misusing it as
                a section heading, which is what `hub.whatYouGet` replaced. */}
            <span class="service-card__link">{strings.buttons.viewService} &rsaquo;</span>
          </a>
        ))}
      </div>
    </section>
  </Base>
) : (
  <Base
    title={`${strings.hub.citiesTitle} — Pasadena Works`}
    description={strings.hub.citiesDescription}
    locale={locale}
    path={localeUrl(locale, SEGMENTS.cityHub[locale])}
    translations={cityHubTranslations}
  >
    <section class="section wrap">
      <h1>{strings.hub.citiesTitle}</h1>
      <p class="prose">{strings.hub.citiesIntro}</p>
      <ul class="city-list">
        {localizedCities.map((city) => (
          <li>
            <a href={localeUrl(locale, SEGMENTS.cityHub[locale], city.slug)}>
              {city.t[locale]!.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </Base>
)}

<style>

  /* .service-card/:hover/__link now live in global.css (todos/024) — this
     page's copy was byte-identical to two others, merged here with
     .city-list a, which stays local since it's not shared elsewhere. */

  .city-list a {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: var(--space-5);
    text-decoration: none;
    color: var(--color-ink);
  }

  .city-list a:hover {
    border-color: var(--color-accent);
  }

  .city-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    /* Matches the English city hub in src/pages/websites/index.astro, which
       sets these in the display face. */
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  /* EXCEPT in Chinese, and this is not a preference.

     `--font-display` is `'Anton', …, var(--font-cjk-display)` — Anton holds no
     Han glyphs, so the stack deliberately hands Chinese to PingFang/Noto while
     Latin gets Anton. That is right for a heading, which is all one script. It
     is wrong here: a zh city-hub item embeds a Latin city name inside CJK
     prose — 亞凱迪亞（Arcadia）商家網站設計與在地推廣 — so "Arcadia" renders
     ultra-bold condensed against regular-weight Chinese, a visible mismatch
     inside a single line. The English hub never shows it because its items are
     pure Latin, and Spanish does not either.

     Seen on the rendered page, not deduced: applying the display face here
     uniformly was tried on 2026-09-06 and looked worse than the inconsistency
     it removed. `:global()` is valid because this IS a scoped <style> block —
     see the gotcha in CLAUDE.md about it being inert in plain .css. */
  :global(html[lang^='zh']) .city-list {
    font-family: var(--font-body);
    font-size: var(--step-0);
  }
</style>
