---
/**
 * Triple-purpose route. Astro can't have two dynamic routes at the same
 * depth — this file already claims [locale]/[section]/[service], so
 * separate [locale]/[cityhub]/[city].astro or [locale]/blog/[slug].astro
 * files would collide with it. Instead this single file generates
 * translated service pages (/es/servicios/sitios-web/), translated city
 * pages (/es/sitios-web/alhambra/), AND translated blog posts
 * (/es/blog/lo-que-un-sitio-web-realmente-necesita/) via getStaticPaths,
 * branching render on the `kind` prop. Don't split this back into
 * separate files.
 */
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Post from '../../../layouts/Post.astro';
import CityBody from '../../../components/CityBody.astro';
import { services, type Service } from '../../../data/services';
import { cities, cityLocales, type City } from '../../../data/cities';
import { SEGMENTS, localeUrl } from '../../../i18n/routes';
import { t } from '../../../i18n/utils';
import { LOCALES, type Locale } from '../../../i18n/ui';
import { getPostsByLocale, getTranslationsFor, postPath } from '../../../utils/blog';
import { readingTime } from '../../../utils/reading-time';

export async function getStaticPaths() {
  const NON_EN = LOCALES.filter((l) => l !== 'en') as Exclude<Locale, 'en'>[];
  const paths: {
    params: { locale: string; section: string; service: string };
    props: Record<string, unknown>;
  }[] = [];

  for (const locale of NON_EN) {
    for (const service of services) {
      paths.push({
        params: {
          locale,
          section: SEGMENTS.services[locale],
          service: service.slugs[locale],
        },
        props: { kind: 'service', locale, service },
      });
    }

    for (const city of cities) {
      if (!cityLocales(city).includes(locale)) continue;
      paths.push({
        params: {
          locale,
          section: SEGMENTS.cityHub[locale],
          service: city.slug,
        },
        props: { kind: 'city', locale, city },
      });
    }

    const posts = await getPostsByLocale(locale);
    for (const post of posts) {
      paths.push({
        params: {
          locale,
          section: SEGMENTS.blog[locale],
          service: post.data.slug,
        },
        props: { kind: 'blog-post', locale, post, translations: await getTranslationsFor(post) },
      });
    }
  }

  return paths;
}

const { kind, locale } = Astro.props as {
  kind: 'service' | 'city' | 'blog-post';
  locale: Locale;
};

type BlogPost = Awaited<ReturnType<typeof getPostsByLocale>>[number];

let blogPost: BlogPost | undefined;
let BlogContent: Awaited<ReturnType<typeof render>>['Content'] | undefined;
let blogReadingMinutes = 0;
let blogTranslations: Partial<Record<Locale, string>> = {};

if (kind === 'blog-post') {
  const props = Astro.props as { post: BlogPost; translations: Partial<Record<Locale, string>> };
  blogPost = props.post;
  blogTranslations = props.translations;
  const rendered = await render(blogPost);
  BlogContent = rendered.Content;
  blogReadingMinutes = readingTime(blogPost.body);
}

const strings = t(locale);

let title = '';
let description = '';
let path = '';
let translations: Partial<Record<Locale, string>> = {};

let service: Service | undefined;
let serviceCopy: Service['t'][Locale] | undefined;

let city: City | undefined;
let cityCopy: NonNullable<City['t'][Locale]> | undefined;

if (kind === 'service') {
  service = Astro.props.service as Service;
  serviceCopy = service.t[locale];
  title = `${serviceCopy.title} — Pasadena Works`;
  description = serviceCopy.meta;
  path = localeUrl(locale, SEGMENTS.services[locale], service.slugs[locale]);
  translations = Object.fromEntries(
    LOCALES.map((l) => [l, localeUrl(l, SEGMENTS.services[l], service!.slugs[l])])
  );
} else if (kind === 'city') {
  city = Astro.props.city as City;
  cityCopy = city.t[locale]!;
  title = `${cityCopy.title} — Pasadena Works`;
  description = cityCopy.meta;
  path = localeUrl(locale, SEGMENTS.cityHub[locale], city.slug);
  const cLocales = cityLocales(city);
  translations = Object.fromEntries(
    (LOCALES.filter((l) => cLocales.includes(l)) as Locale[]).map((l) => [
      l,
      localeUrl(l, SEGMENTS.cityHub[l], city!.slug),
    ])
  );
}

/* A fourth `kind` must fail LOUDLY. Without this it falls through to the last
 * branch: title/description/path keep their '' initializers, absoluteUrl('')
 * resolves to the site root, and the page ships an empty <title> declaring the
 * HOMEPAGE as its canonical — with the build, the tests and the typecheck all
 * green. Proven during the 2026-09-03 review by renaming one `kind` literal to
 * the sibling route's word for the same concept, which shipped exactly that on
 * all 12 translated posts. CLAUDE.md's mitigation was "grep every if/else
 * first", i.e. a machine-checkable invariant guarded by hand; it had already
 * failed once (docs/solutions/logic-errors/
 * dual-purpose-route-bare-else-broke-on-third-kind.md). */
if (kind !== 'service' && kind !== 'city' && kind !== 'blog-post') {
  throw new Error(
    `[locale]/[section]/[service].astro: unhandled kind ${JSON.stringify(kind)}. ` +
      `Add a branch for it here AND in [locale]/[section]/index.astro.`
  );
}
---

{kind === 'blog-post' && blogPost && BlogContent ? (
  <Post
    title={blogPost.data.title}
    description={blogPost.data.description}
    pubDate={blogPost.data.pubDate}
    updatedDate={blogPost.data.updatedDate}
    path={postPath(locale, blogPost.data.slug)}
    locale={locale}
    translations={blogTranslations}
    author={blogPost.data.author}
    tags={blogPost.data.tags}
    pillar={blogPost.data.pillar}
    readingMinutes={blogReadingMinutes}
    heroImage={blogPost.data.heroImage}
    heroAlt={blogPost.data.heroAlt}
    heroCredit={blogPost.data.heroCredit}
  >
    <BlogContent />
  </Post>
) : (
<Base title={title} description={description} locale={locale} path={path} translations={translations}>
  {kind === 'service' && serviceCopy && service && (
    <section class="section wrap prose">
      <p class="eyebrow">{serviceCopy.tagline}</p>
      <h1>{serviceCopy.title}</h1>
      {serviceCopy.body.map((p) => <Fragment set:html={p} />)}
      <h2>{strings.hub.whatYouGet}</h2>
      <ul>
        {serviceCopy.outcomes.map((o) => <li set:html={o} />)}
      </ul>
      <p><a class="btn" href={`${localeUrl(locale)}#contact`}>{strings.buttons.getInTouch}</a></p>
      <p>
        <a href={localeUrl(locale, SEGMENTS.services[locale])}>
          &larr; {strings.buttons.backToServices}
        </a>
      </p>
    </section>
  )}

  {kind === 'city' && cityCopy && city && (
    <section class="section wrap">
      <h1>{cityCopy.title}</h1>
      <p class="prose">{cityCopy.summary}</p>
      <CityBody copy={cityCopy} />
      <p><a class="btn" href={`${localeUrl(locale)}#contact`}>{strings.buttons.getInTouch}</a></p>
      <p>
        <a href={localeUrl(locale, SEGMENTS.cityHub[locale])}>&larr; {strings.buttons.backToCities}</a>
      </p>
    </section>
  )}
</Base>
)}

<style>
  .eyebrow {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-accent-text);
  }
</style>
