---
import { LOCALES, LOCALE_LABEL, LOCALE_ABBR, HTML_LANG, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Path (not full URL) for each locale this page genuinely exists in.
   *  Only locales present here get a link — never render a link to a
   *  translation that doesn't exist. */
  translations: Partial<Record<Locale, string>>;
}

const { locale, translations } = Astro.props;

const available = LOCALES.filter((l) => Boolean(translations[l]));
---

{
  available.length > 1 && (
    <nav class="lang-switch" aria-label="Language">
      <ul>
        {available.map((l) => (
          <li>
            <a
              href={translations[l]}
              hreflang={HTML_LANG[l]}
              aria-current={l === locale ? 'true' : undefined}
              aria-label={LOCALE_LABEL[l]}
              title={LOCALE_LABEL[l]}
              class={l === locale ? 'is-current' : ''}
            >
              {LOCALE_ABBR[l]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .lang-switch ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--step--1);
  }

  .lang-switch a {
    text-decoration: none;
    color: var(--color-ink-soft);
  }

  .lang-switch a.is-current {
    color: var(--color-heading);
    font-weight: 400;
    text-decoration: underline;
  }

  .lang-switch a:hover {
    color: var(--color-accent-dark);
  }
</style>
