---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { SEGMENTS, localeUrl } from '../i18n/routes';
import { site } from '../data/site';
import { cities, cityLocales } from '../data/cities';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const year = new Date().getFullYear();

const home = localeUrl(locale);
const servicesHref = localeUrl(locale, SEGMENTS.services[locale]);
const blogHref = localeUrl(locale, SEGMENTS.blog[locale]);

/** "monterey-park" -> "Monterey Park". City slugs aren't translated (see
 *  cities.ts), so this is a safe display-name derivation. */
const cityDisplayName = (slug: string) =>
  slug
    .split('-')
    // filter(Boolean): a doubled or leading hyphen yields an empty segment, and
    // word[0] on it is undefined — noUncheckedIndexedAccess is off, so it types
    // as string and throws at build instead of being caught.
    .filter(Boolean)
    .map((word) => word[0].toUpperCase() + word.slice(1))
    .join(' ');

const localCities = cities.filter((c) => cityLocales(c).includes(locale));
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__columns">
      <div class="site-footer__col">
        <img class="site-footer__logo" src="/logo-lockup.png" alt={site.name} width="1600" height="578" />
        <p>{strings.footer.serviceAreaBlurb}</p>
      </div>

      <div class="site-footer__col">
        <p class="site-footer__heading">{strings.footer.explore}</p>
        <nav aria-label={strings.footer.explore}>
          <a href={home}>{strings.nav.home}</a>
          <a href={servicesHref}>{strings.nav.services}</a>
          <a href={blogHref}>{strings.nav.blog}</a>
          <a href={`${home}#contact`}>{strings.nav.contact}</a>
          <a href={site.bookingUrl} target="_blank" rel="noopener">{strings.nav.bookCall}</a>
        </nav>
      </div>

      {localCities.length > 0 && (
        <div class="site-footer__col">
          <p class="site-footer__heading">{strings.footer.citiesWeServe}</p>
          <nav aria-label={strings.footer.citiesWeServe}>
            {localCities.map((city) => (
              <a href={localeUrl(locale, SEGMENTS.cityHub[locale], city.slug)}>
                {cityDisplayName(city.slug)}
              </a>
            ))}
          </nav>
        </div>
      )}
    </div>

    <p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      &nbsp;·&nbsp;
      <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
      {locale === 'en' && (
        <>
          &nbsp;·&nbsp;
          <a href="/glossary/">Glossary</a>
        </>
      )}
    </p>
    <p class="site-footer__rights">
      &copy; {year} {site.name}. {strings.footer.rights}
      &nbsp;·&nbsp;<a href="/privacy/">Privacy</a>
      &nbsp;·&nbsp;<a href="/terms/">Terms</a>
      &nbsp;·&nbsp;<a href="/accessibility/">Accessibility</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-rose-dark);
    color: var(--color-blush);
    margin-top: var(--space-9);
  }

  .site-footer__inner {
    padding-block: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-5);
  }

  .site-footer__col nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__heading {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-white);
    margin: 0 0 var(--space-3);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .site-footer__logo {
    /* Logo art is opaque black on a transparent background — the footer
     * panel is always dark rose regardless of site theme, so invert it to
     * white rather than needing a separate light-colored asset. */
    filter: invert(1);
    height: 2.75rem;
    width: auto;
    margin-bottom: var(--space-3);
  }

  .site-footer a {
    color: var(--color-blush);
  }

  .site-footer a:hover {
    color: var(--color-ochre);
  }

  .site-footer__rights {
    font-size: var(--step--1);
    color: var(--color-blush-dark);
    margin-top: var(--space-3);
  }
</style>
