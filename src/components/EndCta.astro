---
import { services } from '../data/services';
import { SEGMENTS, localeUrl } from '../i18n/routes';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import type { Pillar } from '../data/pillars';

interface Props {
  pillar: Pillar;
  locale: Locale;
}

const { pillar, locale } = Astro.props;

const service = services.find((s) => s.id === pillar)!;
const href = localeUrl(locale, SEGMENTS.services[locale], service.slugs[locale]);
const copy = service.t[locale];
const strings = t(locale);
---

<div class="end-cta label-frame">
  <h2>{strings.endCta.heading}</h2>
  <p class="prose">
    {copy.tagline}
  </p>
  <a class="btn" href={href}>{strings.endCta.cta} &rsaquo;</a>
</div>

<style>
  .end-cta {
    margin-top: var(--space-8);
    padding: var(--space-7);
    background: var(--color-surface);
    color: var(--color-ink);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .end-cta h2 {
    margin-bottom: 0;
  }

  .end-cta p {
    margin-bottom: 0;
  }

  .end-cta .btn {
    margin-top: var(--space-2);
  }
</style>
