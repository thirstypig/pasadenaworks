---
/**
 * Gates GA4 behind an actual accept/decline choice — see site.gaMeasurementId
 * for the on/off switch. Renders nothing at all (and the script tag in
 * Base.astro stays out too) when that's blank, so there's never a banner
 * asking for consent to analytics that isn't wired up yet.
 */
import { site } from '../data/site';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

{
  site.gaMeasurementId && (
    <div id="cookie-consent" class="cookie-consent" hidden>
      <p>{strings.misc.cookieNotice}</p>
      <div class="cookie-consent__actions">
        <button type="button" class="btn btn--outline" data-consent="decline">
          {strings.misc.cookieDecline}
        </button>
        <button type="button" class="btn" data-consent="accept">
          {strings.misc.cookieAccept}
        </button>
      </div>
    </div>
  )
}

{
  site.gaMeasurementId && (
    <script define:vars={{ measurementId: site.gaMeasurementId }}>
      const KEY = 'pw-analytics-consent';

      function loadGA(id) {
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', id);
      }

      /* Wrapped, like the equivalent call in Base.astro's pre-paint script.
         localStorage THROWS — not returns null — in a private window or with
         site data blocked, and an uncaught throw here kills the rest of this
         script, so the banner's own buttons would never get their listeners:
         the banner would show and be unusable. Failing to `null` shows the
         banner and loads nothing, which is the right default. */
      const banner = document.getElementById('cookie-consent');
      let saved = null;
      try {
        saved = localStorage.getItem(KEY);
      } catch {
        /* storage unavailable — treat as "no choice recorded yet" */
      }

      if (saved === 'accepted') {
        loadGA(measurementId);
      } else if (saved !== 'declined' && banner) {
        banner.hidden = false;
      }

      banner?.querySelectorAll('[data-consent]').forEach((button) => {
        button.addEventListener('click', () => {
          const choice = button.dataset.consent === 'accept' ? 'accepted' : 'declined';
          try {
            localStorage.setItem(KEY, choice);
          } catch {
            /* The choice cannot be remembered, but it must still be HONOURED for
               this page view — dismiss the banner and respect the answer. */
          }
          banner.hidden = true;
          if (choice === 'accepted') loadGA(measurementId);
        });
      });
    </script>
  )
}

<style>
  .cookie-consent {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 200;
    max-width: 28rem;
    margin-inline: auto;
    padding: var(--space-5);
    background: var(--color-surface);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Higher specificity than the plain class rule above, so this correctly
   * wins and actually hides the banner when the hidden attribute is set —
   * without it, our own `display: flex` overrides the browser's default
   * `[hidden] { display: none }`, and the banner never visually hides. */
  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent p {
    margin: 0;
    font-size: var(--step--1);
  }

  .cookie-consent__actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
  }
</style>
