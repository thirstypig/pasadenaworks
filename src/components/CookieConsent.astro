---
/**
 * Gates GA4 behind an actual accept/decline choice — see site.gaMeasurementId
 * for the on/off switch. Renders nothing at all (and the script tag in
 * Base.astro stays out too) when that's blank, so there's never a banner
 * asking for consent to analytics that isn't wired up yet.
 */
import { site } from '../data/site';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

{
  site.gaMeasurementId && (
    <div id="cookie-consent" class="cookie-consent" hidden>
      <p>{strings.misc.cookieNotice}</p>
      <div class="cookie-consent__actions">
        <button type="button" class="btn btn--outline" data-consent="decline">
          {strings.misc.cookieDecline}
        </button>
        <button type="button" class="btn" data-consent="accept">
          {strings.misc.cookieAccept}
        </button>
      </div>
    </div>
  )
}

{
  site.gaMeasurementId && (
    <script define:vars={{ measurementId: site.gaMeasurementId }}>
      const KEY = 'pw-analytics-consent';

      function loadGA(id) {
        /* ONCE PER PAGE VIEW. Accept, withdraw, then accept again calls this a
           second time, and without the guard that appends a second gtag.js and
           fires a second `config`, which GA4 counts as another page_view for
           the same page — inflating pageviews and sessions for the visitors who
           engage most with the consent control. The `ga-disable` flag set by the
           caller is enough on its own to resume the tag that is already loaded;
           re-loading it was never what resumed collection. */
        if (window.__pwGaLoaded) return;
        window.__pwGaLoaded = true;

        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', id);
      }

      /* Wrapped, like the equivalent call in Base.astro's pre-paint script.
         localStorage THROWS — not returns null — in a private window or with
         site data blocked, and an uncaught throw here kills the rest of this
         script, so the banner's own buttons would never get their listeners:
         the banner would show and be unusable. Failing to `null` shows the
         banner and loads nothing, which is the right default. */
      const banner = document.getElementById('cookie-consent');
      let saved = null;
      try {
        saved = localStorage.getItem(KEY);
      } catch {
        /* storage unavailable — treat as "no choice recorded yet" */
      }

      if (saved === 'accepted') {
        loadGA(measurementId);
      } else if (saved !== 'declined' && banner) {
        banner.hidden = false;
      }

      /* WITHDRAWAL. A banner that asks for consent and offers no way to take it
         back is incoherent on its own terms, whatever the jurisdiction — so the
         footer carries a "cookie settings" control (rendered only when
         gaMeasurementId is set, same as this banner).

         Reopening returns the visitor to "no choice recorded", which means
         analytics must stop NOW and not merely on the next page load. The tag
         cannot be unloaded, so `window['ga-disable-<ID>']` is the lever.

         BE PRECISE ABOUT WHAT IS DOCUMENTED HERE. Google documents this flag as
         a *pre-tag, per-page* switch — "the window property must be set before
         any calls to gtag() are made" — and says nothing about setting it after
         the tag has loaded, which is exactly this case. What Google does state
         is that the check happens at hit time ("when a product attempts to
         set a cookie or send data back … it will first check"), which implies a
         runtime lookup rather than a load-time snapshot, and measuring a real
         gtag.js confirms zero further /g/collect requests once it is set. So:
         observed to work, not a documented guarantee. Consent Mode is the
         documented mechanism for a live toggle and is the upgrade path if this
         ever stops holding. Hits already sent are not retracted either way. */
      /* DELEGATED, and that is not a style preference. `define:vars` forces this
         script to be `is:inline`, so it runs at its own position in the
         document — and this component renders in <body> ABOVE the footer that
         carries the control (char ~9k vs ~24k in the built HTML). Binding
         directly with querySelectorAll finds nothing and fails silently: the
         link renders, clicks, and does nothing at all. Measured, not guessed —
         the first version of this shipped that way and the browser test caught
         it. Delegation on `document` is independent of DOM order. */
      document.addEventListener('click', (event) => {
        const control = event.target instanceof Element
          ? event.target.closest('[data-consent-reopen]')
          : null;
        if (!control) return;
        try {
          localStorage.removeItem(KEY);
        } catch {
          /* Nothing was stored to begin with — the banner still reopens and
             the choice is still honoured for this page view. */
        }
        window['ga-disable-' + measurementId] = true;
        if (banner) {
          banner.hidden = false;
          banner.querySelector('[data-consent]')?.focus();
        }
      });

      banner?.querySelectorAll('[data-consent]').forEach((button) => {
        button.addEventListener('click', () => {
          const choice = button.dataset.consent === 'accept' ? 'accepted' : 'declined';
          try {
            localStorage.setItem(KEY, choice);
          } catch {
            /* The choice cannot be remembered, but it must still be HONOURED for
               this page view — dismiss the banner and respect the answer. */
          }
          banner.hidden = true;
          if (choice === 'accepted') {
            /* Clear any opt-out left by a previous withdrawal. Without this,
               accepting again would hide the banner and look like it worked
               while GA4 kept dropping every hit on the floor. */
            window['ga-disable-' + measurementId] = false;
            loadGA(measurementId);
          }
        });
      });
    </script>
  )
}

<style>
  .cookie-consent {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 200;
    max-width: 28rem;
    margin-inline: auto;
    padding: var(--space-5);
    background: var(--color-surface);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Higher specificity than the plain class rule above, so this correctly
   * wins and actually hides the banner when the hidden attribute is set —
   * without it, our own `display: flex` overrides the browser's default
   * `[hidden] { display: none }`, and the banner never visually hides. */
  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent p {
    margin: 0;
    font-size: var(--step--1);
  }

  .cookie-consent__actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
  }
</style>
