---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<form
  class="contact-form"
  action={site.formEndpoint}
  method="POST"
  id="contact-form"
  data-crm-webhook-url={site.crmWebhookUrl}
  data-msg-sending={strings.form.sending}
  data-msg-success={strings.form.success}
  data-msg-error={strings.form.error}
>
  <!-- Honeypot: real people never fill this in; bots usually do. -->
  <div class="contact-form__hp" aria-hidden="true">
    <label for="company">Company</label>
    <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="_locale" value={locale} />

  <div class="contact-form__field">
    <label for="name">{strings.form.name}</label>
    <input type="text" id="name" name="name" required autocomplete="name" />
  </div>

  <div class="contact-form__field">
    <label for="email">{strings.form.email}</label>
    <input type="email" id="email" name="email" required autocomplete="email" />
  </div>

  <div class="contact-form__field">
    <label for="message">{strings.form.message}</label>
    <textarea id="message" name="message" rows="5" required></textarea>
  </div>

  <button type="submit" class="btn" data-label={strings.form.send}>{strings.form.send}</button>
  <p class="contact-form__status" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('contact-form');

  if (form instanceof HTMLFormElement) {
    const button = form.querySelector('button[type="submit"]');
    const status = form.querySelector('.contact-form__status');
    const crmWebhookUrl = form.dataset.crmWebhookUrl;
    const msgSending = form.dataset.msgSending ?? '';
    const msgSuccess = form.dataset.msgSuccess ?? '';
    const msgError = form.dataset.msgError ?? '';

    if (button instanceof HTMLButtonElement && status instanceof HTMLElement) {
      const sendLabel = button.dataset.label ?? button.textContent ?? '';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        button.disabled = true;
        button.textContent = msgSending;
        status.textContent = '';
        status.classList.remove('contact-form__status--error');

        const data = new FormData(form);

        // Twenty CRM forwarding is best-effort via an n8n webhook — the
        // Formspree submission below is the source of truth for delivery.
        if (crmWebhookUrl) {
          const payload = Object.fromEntries(data.entries());
          fetch(crmWebhookUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          }).catch(() => {});
        }

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });

          if (response.ok) {
            form.reset();
            status.textContent = msgSuccess;
          } else {
            status.textContent = msgError;
            status.classList.add('contact-form__status--error');
          }
        } catch {
          status.textContent = msgError;
          status.classList.add('contact-form__status--error');
        } finally {
          button.disabled = false;
          button.textContent = sendLabel;
        }
      });
    }
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
    width: 100%;
  }

  .contact-form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 400;
  }

  input,
  textarea {
    font: inherit;
    font-family: var(--font-body);
    font-size: 16px; /* prevents iOS Safari auto-zoom on focus */
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-ink);
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-accent);
  }

  .btn {
    align-self: flex-start;
  }

  .contact-form__status {
    margin: 0;
    font-size: var(--step--1);
  }

  .contact-form__status--error {
    color: var(--color-accent);
  }
</style>
