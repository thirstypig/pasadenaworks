---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<form
  class="contact-form"
  action={site.formEndpoint}
  method="POST"
  id="contact-form"
  data-crm-webhook-url={site.crmWebhookUrl}
  data-msg-sending={strings.form.sending}
  data-msg-success={strings.form.success}
  data-msg-error={strings.form.error}
>
  <!-- Honeypot: real people never fill this in; bots usually do.
       The name MUST be `_gotcha` — that is the field Formspree itself drops
       on. It was `company`, which meant Formspree ignored it, and the submit
       handler never read it either, so the honeypot was decorative: present in
       the markup, enforced nowhere. It is checked below as well, because the
       CRM webhook call does not go through Formspree at all.

       THE LABEL IS NOT DECORATIVE, AND IT USED TO SAY "Company". That is an
       address-profile field name, and Chrome's address autofill matches on the
       label — it also ignores `autocomplete="off"` for address forms, which is
       long-standing documented behaviour, not a bug. So a visitor with a saved
       address profile could have this filled FOR them, and the handler below
       discards a real enquiry while showing the success message: total, silent
       lead loss on the site's only conversion path. The name must stay
       `_gotcha` (Formspree drops on it) but the label must not name a field
       any autofill profile knows. Nothing reads this text — the wrapper is
       aria-hidden and the input is tabindex="-1" — so it costs nothing. -->
  <div class="contact-form__hp" aria-hidden="true">
    <label for="_gotcha">Leave this field empty</label>
    <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="_locale" value={locale} />

  <div class="contact-form__field">
    <label for="name">{strings.form.name}</label>
    <input type="text" id="name" name="name" required autocomplete="name" />
  </div>

  <div class="contact-form__field">
    <label for="email">{strings.form.email}</label>
    <input type="email" id="email" name="email" required autocomplete="email" />
  </div>

  <div class="contact-form__field">
    <label for="message">{strings.form.message}</label>
    <textarea id="message" name="message" rows="5" required></textarea>
  </div>

  <button type="submit" class="btn" data-label={strings.form.send}>{strings.form.send}</button>
  <p class="contact-form__status" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('contact-form');

  if (form instanceof HTMLFormElement) {
    const button = form.querySelector('button[type="submit"]');
    const status = form.querySelector('.contact-form__status');
    const crmWebhookUrl = form.dataset.crmWebhookUrl;
    const msgSending = form.dataset.msgSending ?? '';
    const msgSuccess = form.dataset.msgSuccess ?? '';
    const msgError = form.dataset.msgError ?? '';

    if (button instanceof HTMLButtonElement && status instanceof HTMLElement) {
      const sendLabel = button.dataset.label ?? button.textContent ?? '';

      // The last payload actually sent to the CRM, serialised. The CRM call
      // below is deliberately NOT awaited and fires BEFORE Formspree, so that a
      // Formspree outage still puts the lead somewhere — two independent paths
      // is the point. The cost is that a failed Formspree submit shows
      // msgError, the visitor presses Send again, and Twenty gets a SECOND
      // person and note for one enquiry. Remembering what was sent keeps the
      // redundancy and drops the duplicate; it never clears, because a
      // byte-identical enquiry twice in one page view is a double-submit, not
      // two enquiries.
      let lastCrmPayload: string | null = null;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        button.disabled = true;
        button.textContent = msgSending;
        status.textContent = '';
        status.classList.remove('contact-form__status--error');

        const data = new FormData(form);

        // Honeypot filled => a bot. Report success and send nothing: a bot that
        // is told it failed retries, and the CRM webhook is a public endpoint
        // (see todos/013), so the client-side check is the only thing standing
        // between a scripted form fill and a forged CRM record.
        if (String(data.get('_gotcha') ?? '').trim() !== '') {
          form.reset();
          button.disabled = false;
          button.textContent = sendLabel;
          status.textContent = msgSuccess;
          return;
        }

        // Twenty CRM forwarding is best-effort via an n8n webhook — the
        // Formspree submission below is the source of truth for delivery.
        if (crmWebhookUrl) {
          const payload = Object.fromEntries(data.entries());
          // `mode: 'no-cors'` is required here — the n8n webhook returns no
          // CORS headers, so an ordinary request is blocked outright. The cost
          // is that the browser then allows only three Content-Type values and
          // SILENTLY DROPS anything else, so this body always arrives as
          // text/plain no matter what we ask for. Confirmed in n8n's own
          // execution log (ID#5): `content-type: text/plain;charset=UTF-8`.
          //
          // We therefore declare what is actually sent instead of a value the
          // browser discards. This header said `application/json` for ten days
          // and read as though the receiver would get parsed JSON; it got a
          // string, `$json.body.name` was undefined, and every enquiry created
          // a BLANK person in Twenty while the site, n8n and the CRM all
          // reported success. The workflow's `Normalise payload` node now
          // parses it. See todos/013.
          const serialised = JSON.stringify(payload);
          if (serialised !== lastCrmPayload) {
            lastCrmPayload = serialised;
            fetch(crmWebhookUrl, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
              body: serialised,
            }).catch(() => {});
          }
        }

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });

          if (response.ok) {
            form.reset();
            status.textContent = msgSuccess;
          } else {
            status.textContent = msgError;
            status.classList.add('contact-form__status--error');
          }
        } catch {
          status.textContent = msgError;
          status.classList.add('contact-form__status--error');
        } finally {
          button.disabled = false;
          button.textContent = sendLabel;
        }
      });
    }
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
    width: 100%;
  }

  .contact-form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 400;
  }

  input,
  textarea {
    font: inherit;
    font-family: var(--font-body);
    font-size: 16px; /* prevents iOS Safari auto-zoom on focus */
    width: 100%;
    padding: var(--space-3);
    /* --color-line-control, not --color-line. These fields sit on a
       .contact-frame that is ALSO --color-surface, so this border is the only
       thing identifying the control — WCAG 1.4.11 wants 3:1 where that is true.
       --color-line measured 1.45:1 light and 1.27:1 dark; in dark mode the
       fields read as ghost boxes. */
    border: 1px solid var(--color-line-control);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-accent);
  }

  .btn {
    align-self: flex-start;
  }

  .contact-form__status {
    margin: 0;
    font-size: var(--step--1);
  }

  .contact-form__status--error {
    /* --color-accent (ochre) measured 3.04:1 on white, under the 4.5:1 AA
       needs. --color-accent-text is defined per theme for exactly this — it is
       #8c5c17 in light (5.74:1) and resolves to ochre in dark (5.59:1). This is
       the one string a user MUST be able to read, because it only appears when
       their message failed to send. */
    color: var(--color-accent-text);
  }
</style>
